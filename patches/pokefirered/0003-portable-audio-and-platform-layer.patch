+    u16 tempoScale; // 0x100 initially
+    u16 tempoInterval; // 150 initially
+    u16 tempoCounter;
+    u16 fadeInterval;
+    u16 fadeCounter;
+    u16 isFadeTemporary:1;
+    u16 isFadeIn:1;
+    u16 fadeVolume:7;
+    u16 :7; // padding
+    struct MP2KTrack *tracks;
+    struct MP2KInstrument *voicegroup;
+    vu32 lockStatus;
+    void (*nextPlayerFunc)(void *);
+    void *nextPlayer;
+};
+
+struct MP2KPlayerCtor {
