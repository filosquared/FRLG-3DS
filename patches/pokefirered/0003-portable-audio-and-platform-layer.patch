+struct WaveData2
+{
+    u8 compressionFlags1;
+    u8 compressionFlags2;
+    u8 compressionFlags3;
+    u8 loopFlags;
+    u32 freq;  // 22.10 fixed width decimal, freq of C4. Or just the frequency of C14.
+    u32 loopStart;
+    u32 size; // number of samples
+    s8 data[]; // samples
+};
+
+
+struct MP2KInstrument {
+    u8 type;
+    u8 drumKey;
+    u8 cgbLength;
