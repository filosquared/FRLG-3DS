+                                } \
+                                else if(REG_BLDCNT & BLDCNT_TGT1_OBJ && winShouldBlendPixel) \
+                                { \
+                                    switch (blendMode) \
+                                    { \
+                                        case 2: \
+                                            color = alphaBrightnessIncrease(color); \
