+                            writeSpritePixelWinBlend((pixel32 >> 8) & 0xF, x+5)
+                            writeSpritePixelWinBlend((pixel32 >> 4) & 0xF, x+6)
+                            writeSpritePixelWinBlend(pixel32 & 0xF, x+7)
+                        }
+                        else
