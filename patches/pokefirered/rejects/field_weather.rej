                 b1 = color1.b;
 
                 offset = ((b1 & 0x1E) << 7) | ((g1 & 0x1E) << 3) | ((r1 & 0x1E) >> 1);
+#ifdef PORT_BRIDGE
+                color2 = *(struct RGBColor *)&droughtColors[offset];
