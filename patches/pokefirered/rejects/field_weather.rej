@@ -550,7 +585,11 @@ static void ApplyColorMap(u8 startPalIndex, u8 numPalettes, s8 colorMapIndex)
             {
                 for (i = 0; i < 16; i++)
                 {
+#ifdef PORT_BRIDGE
+                    gPlttBufferFaded[palOffset] = droughtColors[DROUGHT_COLOR_INDEX(gPlttBufferUnfaded[palOffset])];
+#else
                     gPlttBufferFaded[palOffset] = sDroughtWeatherColors[colorMapIndex][DROUGHT_COLOR_INDEX(gPlttBufferUnfaded[palOffset])];
+#endif
                     palOffset++;
                 }
             }
@@ -565,7 +604,11 @@ static void ApplyColorMap(u8 startPalIndex, u8 numPalettes, s8 colorMapIndex)
     }
 }
 
