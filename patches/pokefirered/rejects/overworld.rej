+                        (gMapHeader.events != NULL) ? gMapHeader.events->objectEventCount : 0,
+                        CheckHeap(),
+                        0);
+#endif
     TryRunOnWarpIntoMapScript();
+#ifdef PORT_BRIDGE
+    Port_SetBirchDebugEx(0x0218, CheckHeap(), 0, 0, 0);
+#endif
 }
 
