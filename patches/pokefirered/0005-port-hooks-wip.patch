+#ifdef PORT_BRIDGE
+// The centered port view reaches beyond the GBA collision/save-map padding,
+// and the 3D view further still. What it shows there is visual only: keep
+// MAP_OFFSET and the saved mapView layout unchanged.
+//
+// The maps that can be seen are the current map, its connections and theirs,
+// placed as voxel_world.c places them. Where none of them reaches, the GBA
+// tiles the current map's border block for ever. Its 15 x 10 screen never
+// looked far enough past a corner for that to matter; this one does, and the
+// ground past a corner - outside both the map and its neighbour - changed
+// drawing the moment the player crossed, because the border followed
+// whichever map was current. So each such cell takes the border of the
+// nearest map instead: the one whose edge it lies against, whichever map the
+// player stands on.
+//
+// Only a border the current tilesets can draw is a candidate; next to a map
+// with other tilesets such borders fall back to the next nearest map,
+// ultimately the current one, as before.
+//
+// FRLG: borders are borderWidth x borderHeight blocks (not always 2x2),
+// phased on the map's origin as GetBorderBlockAt phases them.
+#define CAMERA_MAPS_MAX 16
+
+struct CameraMap
+{
+    const struct MapHeader *header;
+    u16 id;          // mapGroup << 8 | mapNum: the stable tie-break
+    s16 x, y;        // origin, in metatiles of the current map
+    s16 phaseX, phaseY; // origin its border is phased on
+    bool8 drawn;     // its ground is drawn here
+    bool8 border;    // its border is drawable with the current tilesets
+#ifdef PLATFORM_3DS
+    u8 bank;         // 1 + the bank of its own secondary tileset, 0 for none
+#endif
+};
+
+static struct CameraMap sCameraMaps[CAMERA_MAPS_MAX];
+static u8 sCameraMapCount;
+#ifdef PLATFORM_3DS
+// Bumped whenever the maps are placed again; the banks are given out for it.
+static u32 sCameraMapsGeneration, sCameraBanksGeneration;
+#endif
+static const struct MapLayout *sCameraMapsLayout;
+static const struct MapConnections *sCameraMapsConnections;
+static u16 sCameraMapsId;
+
+static bool8 CameraTilesetsMatch(const struct MapLayout *layout)
+{
+    return layout->primaryTileset == gMapHeader.mapLayout->primaryTileset
+        && layout->secondaryTileset == gMapHeader.mapLayout->secondaryTileset;
+}
+
+static bool8 CameraBorderDrawable(const struct MapLayout *layout)
+{
+    const u16 *border;
+    int i;
+
+    if (layout->border == NULL || layout->borderWidth == 0 || layout->borderHeight == 0
+     || layout->primaryTileset != gMapHeader.mapLayout->primaryTileset)
+        return FALSE;
+    if (layout->secondaryTileset == gMapHeader.mapLayout->secondaryTileset)
+        return TRUE;
+    border = Port_ResolveAssetPointer(layout->border);
+    if (border == NULL)
+        return FALSE;
+    for (i = 0; i < layout->borderWidth * layout->borderHeight; i++)
+        if ((border[i] & MAPGRID_METATILE_ID_MASK) >= NUM_METATILES_IN_PRIMARY)
+            return FALSE;
+    return TRUE;
+}
+
+static void PlaceCameraMap(const struct MapHeader *header, u16 id, int x, int y, bool8 near)
+{
+    struct CameraMap *map = &sCameraMaps[sCameraMapCount++];
+
+    map->header = header;
+    map->id = id;
+    map->x = map->phaseX = x;
+    map->y = map->phaseY = y;
+    map->drawn = near || CameraTilesetsMatch(header->mapLayout);
+    map->border = CameraBorderDrawable(header->mapLayout);
+#ifdef PLATFORM_3DS
+    map->bank = 0;
+#endif
+}
+
+// The maps across the side connections of sCameraMaps[from]. The current map's
+// own are taken as they are; one further away (far) only where it is not a
+// map already placed and covers none of their ground, as in voxel_world.c.
+static void AddCameraConnections(int from, bool8 far)
+{
+    const struct MapHeader *header = sCameraMaps[from].header;
+    const struct MapConnection *connection;
+    int i, k;
+
+    if (header->connections == NULL)
+        return;
+    connection = header->connections->connections;
+    for (i = 0; i < header->connections->count; i++, connection++)
+    {
+        const struct CameraMap *source = &sCameraMaps[from];
+        const struct MapHeader *neighbour;
+        const struct MapLayout *layout;
+        u16 id = (connection->mapGroup << 8) | connection->mapNum;
+        int x, y;
+        bool8 clash = FALSE;
+
+        if (sCameraMapCount >= CAMERA_MAPS_MAX)
+            return;
+        neighbour = GetMapHeaderFromConnection(connection);
+        if (neighbour == NULL || neighbour->mapLayout == NULL)
+            continue;
+        layout = neighbour->mapLayout;
+        switch (connection->direction)
+        {
+        case CONNECTION_NORTH:
+            x = source->x + connection->offset;
+            y = source->y - layout->height;
+            break;
+        case CONNECTION_SOUTH:
+            x = source->x + connection->offset;
+            y = source->y + header->mapLayout->height;
+            break;
+        case CONNECTION_WEST:
+            x = source->x - layout->width;
+            y = source->y + connection->offset;
+            break;
+        case CONNECTION_EAST:
+            x = source->x + header->mapLayout->width;
+            y = source->y + connection->offset;
+            break;
+        default:
+            continue;
+        }
+        for (k = 0; far && k < sCameraMapCount && !clash; k++)
+        {
+            const struct CameraMap *placed = &sCameraMaps[k];
+            const struct MapLayout *other = placed->header->mapLayout;
+
+            clash = placed->id == id
+                 || (x < placed->x + other->width && x + layout->width > placed->x
+                  && y < placed->y + other->height && y + layout->height > placed->y);
+        }
+        if (!clash)
+            PlaceCameraMap(neighbour, id, x, y, !far);
+    }
+}
+
+static void UpdateCameraMaps(void)
+{
+    u16 id = (gSaveBlock1Ptr->location.mapGroup << 8) | gSaveBlock1Ptr->location.mapNum;
+    int near, i;
+
+    if (sCameraMapCount != 0 && sCameraMapsLayout == gMapHeader.mapLayout
+     && sCameraMapsConnections == gMapHeader.connections && sCameraMapsId == id)
+        return;
+    sCameraMapsLayout = gMapHeader.mapLayout;
+    sCameraMapsConnections = gMapHeader.connections;
+    sCameraMapsId = id;
+    sCameraMapCount = 0;
+#ifdef PLATFORM_3DS
+    sCameraMapsGeneration++;
+#endif
+    PlaceCameraMap(&gMapHeader, id, 0, 0, TRUE);
+    AddCameraConnections(0, FALSE);
+    near = sCameraMapCount;
+    for (i = 1; i < near; i++)
+        AddCameraConnections(i, TRUE);
+
+    // Neighbours often share one border block, and a map phases it on its own
+    // origin: two neighbours an odd number of tiles apart would show the
+    // pattern break where one's border gives way to the other's. Maps with
+    // the same block take the phase of the lowest id among them instead.
+    for (i = 0; i < sCameraMapCount; i++)
+    {
+        const struct MapLayout *layout = sCameraMaps[i].header->mapLayout;
+        const u16 *border = Port_ResolveAssetPointer(layout->border);
+        u16 anchor = sCameraMaps[i].id;
+        int k;
+
+        if (border == NULL)
+            continue;
+        for (k = 0; k < sCameraMapCount; k++)
+        {
+            const struct MapLayout *otherLayout = sCameraMaps[k].header->mapLayout;
+            const u16 *other = Port_ResolveAssetPointer(otherLayout->border);
+
+            if (sCameraMaps[k].id < anchor && other != NULL
+             && otherLayout->borderWidth == layout->borderWidth
+             && otherLayout->borderHeight == layout->borderHeight
+             && memcmp(border, other, layout->borderWidth * layout->borderHeight * sizeof(u16)) == 0)
+            {
+                anchor = sCameraMaps[k].id;
+                sCameraMaps[i].phaseX = sCameraMaps[k].x;
+                sCameraMaps[i].phaseY = sCameraMaps[k].y;
+            }
+        }
+    }
+}
+
+// The border at x, y (metatiles of the current map): that of the nearest map
+// whose border can be drawn, as the layout's unresolved pointer, and which of
+// its blocks. Distance is to the map's rectangle; a tie goes to the lower
+// map id, never to the current map, so the answer is the same from either side
+// of a crossing. The block is phased on that map's own origin, as
+// GetBorderBlockAt phases it when that map is the current one (or on the map
+// that shares its block, above).
+const u16 *MapGridGetCameraBorderAt(int x, int y, u8 *index)
+{
+    const struct CameraMap *best = NULL;
+    const struct MapLayout *bestLayout;
+    u32 bestDistance = 0;
+    int i, w, h;
+
+    UpdateCameraMaps();
+    for (i = 0; i < sCameraMapCount; i++)
+    {
+        const struct CameraMap *map = &sCameraMaps[i];
+        const struct MapLayout *layout = map->header->mapLayout;
+        int dx = 0, dy = 0;
+        u32 distance;
+
+        if (!map->border)
+            continue;
+        if (x < map->x)
+            dx = map->x - x;
+        else if (x >= map->x + layout->width)
+            dx = x - (map->x + layout->width - 1);
+        if (y < map->y)
+            dy = map->y - y;
+        else if (y >= map->y + layout->height)
+            dy = y - (map->y + layout->height - 1);
+        distance = dx * dx + dy * dy;
+        if (best == NULL || distance < bestDistance
+         || (distance == bestDistance && map->id < best->id))
+        {
+            best = map;
+            bestDistance = distance;
+        }
+    }
+    if (best == NULL)
+        best = &sCameraMaps[0];
+    bestLayout = best->header->mapLayout;
+    w = bestLayout->borderWidth != 0 ? bestLayout->borderWidth : 1;
+    h = bestLayout->borderHeight != 0 ? bestLayout->borderHeight : 1;
+    x -= best->phaseX;
+    y -= best->phaseY;
+    x %= w;
+    if (x < 0)
+        x += w;
+    y %= h;
+    if (y < 0)
+        y += h;
+    *index = x + y * w;
+    return bestLayout->border;
+}
+
+static u16 GetNearestBorderBlockAt(int x, int y)
+{
+    u8 index;
+    const u16 *border = Port_ResolveAssetPointer(MapGridGetCameraBorderAt(x, y, &index));
+
+    return border[index] | MAPGRID_COLLISION_MASK;
+}
+
+#ifdef PLATFORM_3DS
+// FRLG: 3ds_tile_banks.h describes Emerald's VRAM split (512 primary tiles,
+// palettes 6-12); FireRed's is 640 tiles and palettes 7-12, which the
+// renderer's bank constants have to follow before the banks are used.
+
+// The tilesets that hold the banks (3ds_tile_banks.h), as last handed over.
+static const struct Tileset *sBankTilesets[CTR_TILE_BANKS];
+
+// A secondary tileset's own palettes, unfaded.
+static bool8 ReadTileBankPalettes(const struct Tileset *tileset, u16 *palettes)
+{
+    if (Port_GetAssetSizeExact(tileset->palettes) != 0)
+        return Port_LoadAssetRangeToBuffer(tileset->palettes, CTR_TILE_BANK_FIRST_PALETTE * PLTT_SIZE_4BPP,
+                                           palettes, CTR_TILE_BANK_PALETTES * PLTT_SIZE_4BPP);
+    else
+    {
+        const u16 (*source)[16] = Port_ResolveAssetPointer(tileset->palettes);
+
+        if (source == NULL)
+            return FALSE;
+        memcpy(palettes, source[CTR_TILE_BANK_FIRST_PALETTE], CTR_TILE_BANK_PALETTES * PLTT_SIZE_4BPP);
+        return TRUE;
+    }
+}
+
+// A secondary tileset's tiles and palettes into bank `bank`.
+static void LoadCameraTileBank(u8 bank, const struct Tileset *tileset)
+{
+    u16 palettes[CTR_TILE_BANK_PALETTES * 16];
+    const void *tiles = tileset->tiles;
+    void *decompressed = NULL;
+    u32 size;
+    // Timed for the log: loaded in the field's frame, as the camera draws.
+    uint64_t started = CtrPlatform_Ticks();
+
+    if (!ReadTileBankPalettes(tileset, palettes))
+        return;
+    if (tileset->isCompressed)
+    {
+        decompressed = MallocAndDecompress(tiles, &size);
+        tiles = decompressed;
+    }
+    else
+    {
+        size = Port_GetAssetSizeExact(tiles);
+        if (size == 0 || size > CTR_TILE_BANK_BYTES)
+            size = CTR_TILE_BANK_BYTES;
+        tiles = Port_ResolveAssetPointerSized(tiles, size);
+    }
+    if (tiles == NULL || size == 0)
+    {
+        CtrLog_Write(CTR_LOG_GAME, "2D tile bank %u: the tileset's tiles could not be read", bank);
+        if (decompressed != NULL)
+            Free(decompressed);
+        return;
+    }
+    CtrVideo_SetTileBank(bank, tiles, size, palettes);
+    sBankTilesets[bank] = tileset;
+    if (decompressed != NULL)
+        Free(decompressed);
+    CtrLog_Write(CTR_LOG_GAME, "2D tile bank %u: %lu bytes of tiles, for map %u/%u, %.2f ms", bank, (unsigned long)size,
+                 gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum,
+                 (double)CtrPlatform_TickMs(CtrPlatform_Ticks() - started));
+}
+
+// Crossing into a map that a bank held: that bank is free from now on, and
+// the map left behind wants one, its secondary tileset still whole in VRAM
+// (the crossing loads the next one over it). Copied there, the bank is ready
+// without decompressing the tileset again, as crossing back and forth would.
+static void KeepOutgoingTileset(const struct MapHeader *incoming)
+{
+    const struct Tileset *outgoing = gMapHeader.mapLayout->secondaryTileset;
+    const struct Tileset *next;
+    u16 palettes[CTR_TILE_BANK_PALETTES * 16];
+    int bank;
+
+    if (incoming == NULL || incoming->mapLayout == NULL || outgoing == NULL)
+        return;
+    next = incoming->mapLayout->secondaryTileset;
+    if (next == outgoing || incoming->mapLayout->primaryTileset != gMapHeader.mapLayout->primaryTileset)
+        return;
+    for (bank = 0; bank < CTR_TILE_BANKS && sBankTilesets[bank] != next; bank++)
+        ;
+    if (bank == CTR_TILE_BANKS || !ReadTileBankPalettes(outgoing, palettes))
+        return;
+    CtrVideo_SetTileBank(bank, (const void *)(BG_VRAM + NUM_TILES_IN_PRIMARY * TILE_SIZE_4BPP),
+                         CTR_TILE_BANK_BYTES, palettes);
+    sBankTilesets[bank] = outgoing;
+    CtrLog_Write(CTR_LOG_GAME, "2D tile bank %u: kept from VRAM, leaving map %u/%u", bank,
+                 gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum);
+}
+
+// The banks for the maps placed: a map drawn with other tilesets than the
+// current map's - the same primary, another secondary - takes the bank of its
+// secondary tileset, nearest maps first, as many tilesets as there are banks.
+// A tileset keeps the bank it already holds, so crossing back and forth
+// loads only the one the current map gave up.
+static void AssignCameraBanks(void)
+{
+    const struct Tileset *wanted[CTR_TILE_BANKS];
+    u8 slot[CTR_TILE_BANKS];
