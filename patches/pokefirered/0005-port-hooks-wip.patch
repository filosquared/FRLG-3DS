+            ;
+        if (w == count)
+        {
+            if (count == CTR_TILE_BANKS)
+                continue;
+            wanted[count++] = layout->secondaryTileset;
+        }
+        map->bank = w + 1;
+    }
+    for (w = 0; w < count; w++)
